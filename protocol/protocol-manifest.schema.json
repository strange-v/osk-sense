{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osk-sense:protocol-manifest-schema:1",
  "title": "OSK Sense protocol artifacts",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/vector_document" }
  ],
  "$defs": {
    "security_v3": {
      "type": "object",
      "properties": {
        "protocol_major": { "const": 3 },
        "node_tag_bytes": { "const": 8 },
        "gateway_tag_bytes": { "const": 6 },
        "counter_bytes": { "const": 4 },
        "counter_encoding": { "const": "uint32_le" },
        "activation_header": { "const": 106 },
        "ack_logical_header": { "const": 127 },
        "max_wire_bytes": { "const": 61 },
        "max_ack_payload_bytes": { "const": 10 },
        "salt_bytes": { "const": 8 },
        "request_nonce_bytes": { "const": 8 },
        "join_wire_sizes": { "const": { "request": 33, "accept": 35, "confirm": 27, "complete": 25 } },
        "command_payload": { "const": { "envelope_bytes": 3, "max_bytes": 11, "ready_bytes": 0, "no_command_bytes": 0 } }
      },
      "required": ["protocol_major", "node_tag_bytes", "gateway_tag_bytes", "counter_bytes", "counter_encoding", "activation_header", "ack_logical_header", "max_wire_bytes", "max_ack_payload_bytes", "salt_bytes", "request_nonce_bytes", "join_wire_sizes", "command_payload"],
      "additionalProperties": false
    },
    "crypto_v3": {
      "type": "object",
      "properties": {
        "factory_key": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "salt": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "encryption_key": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "authentication_key": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "counter": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "node_id": { "type": "integer", "minimum": 1, "maximum": 99 },
        "gateway_id": { "const": 100 },
        "plaintext": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
        "telemetry": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "activation": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "ack_floor": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "command": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "join_confirm": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "pairing_request": { "type": "string", "pattern": "^[0-9a-f]{66}$" },
        "pairing_accept": { "type": "string", "pattern": "^[0-9a-f]{70}$" },
        "pairing_confirm": { "type": "string", "pattern": "^[0-9a-f]{54}$" },
        "pairing_complete": { "type": "string", "pattern": "^[0-9a-f]{50}$" },
        "session_command": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "session_result": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "session_ready": { "type": "string", "pattern": "^[0-9a-f]{26}$" },
        "session_no_command": { "type": "string", "pattern": "^[0-9a-f]{22}$" }
      },
      "required": ["factory_key", "salt", "encryption_key", "authentication_key", "counter", "node_id", "gateway_id", "plaintext", "telemetry", "activation", "ack_floor", "command", "join_confirm", "pairing_request", "pairing_accept", "pairing_confirm", "pairing_complete", "session_command", "session_result", "session_ready", "session_no_command"],
      "additionalProperties": false
    },
    "artifact_header": {
      "type": "object",
      "properties": {
        "$schema": { "type": "string" },
        "schema_version": { "const": 1 }
      },
      "required": ["$schema", "schema_version"]
    },
    "scale": {
      "type": "object",
      "properties": {
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer", "minimum": 1 }
      },
      "required": ["numerator", "denominator"],
      "additionalProperties": false
    },
    "raw_range": {
      "type": "object",
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable machine identifier. Telemetry field names are unique within a complete profile and the same name across profiles retains compatible quantity and unit semantics."
        },
        "quantity": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "offset": { "type": "integer", "minimum": 0 },
        "encoding": {
          "enum": [
            "uint8",
            "int8",
            "int16_le",
            "uint16_le",
            "uint32_le",
            "uint64_le",
            "bytes"
          ]
        },
        "length": { "type": "integer", "minimum": 1 },
        "length_from": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "format": { "enum": ["lowercase_hex"] },
        "scale": { "$ref": "#/$defs/scale" },
        "unit": { "type": "string", "minLength": 1 },
        "valid_raw": { "$ref": "#/$defs/raw_range" },
        "allowed_raw": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 1,
          "uniqueItems": true
        },
        "no_value_raw": {
          "oneOf": [
            { "enum": ["type_min", "type_max"] },
            { "type": "integer" }
          ]
        },
        "const_raw": { "type": "integer" },
        "bits": {
          "type": "array",
          "description": "Named sub-fields of an integer field. Bits outside every mask are reserved and must be zero.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "quantity": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "mask": { "type": "integer", "minimum": 1, "maximum": 255 }
            },
            "required": ["name", "mask"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["name", "offset", "encoding"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "encoding": { "const": "bytes" } },
            "required": ["encoding"]
          },
          "then": {
            "oneOf": [
              { "required": ["length"] },
              { "required": ["length_from"] }
            ]
          }
        }
      ]
    },
    "fixed_size": {
      "type": "object",
      "properties": {
        "fixed": { "type": "integer", "minimum": 1 }
      },
      "required": ["fixed"],
      "additionalProperties": false
    },
    "variable_size": {
      "type": "object",
      "properties": {
        "base": { "type": "integer", "minimum": 1 },
        "plus_field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "required": ["base", "plus_field"],
      "additionalProperties": false
    },
    "stream_message": {
      "type": "object",
      "properties": {
        "kind": { "type": "integer", "minimum": 1, "maximum": 255 },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "size": {
          "oneOf": [
            { "$ref": "#/$defs/fixed_size" },
            { "$ref": "#/$defs/variable_size" }
          ]
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      },
      "required": ["kind", "name", "size", "fields"],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "frame_size": { "type": "integer", "minimum": 3, "maximum": 255 },
        "commands": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 255 },
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      },
      "required": ["id", "name", "frame_size", "commands", "fields"],
      "additionalProperties": false
    },
    "frame_kind": {
      "type": "object",
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 31 },
        "header": { "type": "integer", "minimum": 0, "maximum": 255 },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "required": ["value", "header", "name"],
      "additionalProperties": false
    },
    "radio": {
      "type": "object",
      "properties": {
        "protocol_major": { "type": "integer", "minimum": 0, "maximum": 7 },
        "header": {
          "type": "object",
          "properties": {
            "offset": { "const": 0 },
            "encoding": { "const": "uint8" },
            "protocol_major_mask": { "type": "integer", "minimum": 0, "maximum": 255 },
            "protocol_major_shift": { "type": "integer", "minimum": 0, "maximum": 7 },
            "frame_kind_mask": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "required": [
            "offset",
            "encoding",
            "protocol_major_mask",
            "protocol_major_shift",
            "frame_kind_mask"
          ],
          "additionalProperties": false
        },
        "frame_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/frame_kind" },
          "minItems": 1
        },
        "telemetry_ack_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mask": { "enum": [1, 2, 4, 8, 16, 32, 64, 128] },
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            },
            "required": ["mask", "name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["protocol_major", "header", "frame_kinds", "telemetry_ack_flags"],
      "additionalProperties": false
    },
    "command_frame": {
      "type": "object",
      "properties": {
        "header": { "type": "integer", "minimum": 0, "maximum": 255 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" },
          "minItems": 1
        }
      },
      "required": ["header", "fields"],
      "additionalProperties": false
    },
    "command_type": {
      "type": "object",
      "properties": {
        "type": { "type": "integer", "minimum": 1, "maximum": 255 },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "result": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      },
      "required": ["type", "name", "arguments", "result"],
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "offset_base": { "const": "application_frame" },
        "envelope_size": { "type": "integer", "minimum": 1 },
        "command": { "$ref": "#/$defs/command_frame" },
        "result": { "$ref": "#/$defs/command_frame" },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": { "type": "integer", "minimum": 0, "maximum": 255 },
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            },
            "required": ["value", "name"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "types": {
          "type": "array",
          "items": { "$ref": "#/$defs/command_type" },
          "minItems": 1
        }
      },
      "required": [
        "offset_base",
        "envelope_size",
        "command",
        "result",
        "statuses",
        "types"
      ],
      "additionalProperties": false
    },
    "gateway_stream": {
      "type": "object",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 255 },
        "byte_order": { "const": "little_endian" },
        "common_prefix_size": { "type": "integer", "minimum": 1 },
        "common_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" },
          "minItems": 1
        },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/stream_message" },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "byte_order",
        "common_prefix_size",
        "common_fields",
        "messages"
      ],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "offset_base": { "const": "application_frame" },
        "header": { "type": "integer", "minimum": 0, "maximum": 255 },
        "common_prefix_size": { "type": "integer", "minimum": 1 },
        "common_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" },
          "minItems": 1
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" },
          "minItems": 1
        }
      },
      "required": [
        "offset_base",
        "header",
        "common_prefix_size",
        "common_fields",
        "profiles"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "allOf": [
        { "$ref": "#/$defs/artifact_header" },
        {
          "type": "object",
          "properties": {
            "$schema": { "type": "string" },
            "schema_version": { "const": 1 },
            "scope": { "const": "gateway_client_telemetry" },
            "security_v3": { "$ref": "#/$defs/security_v3" },
            "radio": { "$ref": "#/$defs/radio" },
            "commands": { "$ref": "#/$defs/commands" },
            "gateway_stream": { "$ref": "#/$defs/gateway_stream" },
            "telemetry": { "$ref": "#/$defs/telemetry" }
          },
          "required": [
            "$schema",
            "schema_version",
            "scope",
            "radio",
            "commands",
            "gateway_stream",
            "telemetry"
          ],
          "additionalProperties": false
        }
      ]
    },
    "telemetry_vector": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "profile_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" },
        "raw": { "type": "object", "additionalProperties": { "type": ["integer", "null"] } },
        "values": { "type": "object", "additionalProperties": { "type": ["number", "null"] } }
      },
      "required": ["name", "profile_id", "hex", "raw", "values"],
      "additionalProperties": false
    },
    "invalid_telemetry_vector": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "profile_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" },
        "error": {
          "enum": ["wrong_header", "wrong_length", "invalid_value"]
        }
      },
      "required": ["name", "profile_id", "hex", "error"],
      "additionalProperties": false
    },
    "command_vector": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "frame": { "enum": ["command", "command_result"] },
        "command_type": { "type": "integer", "minimum": 1, "maximum": 255 },
        "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" },
        "decoded": { "type": "object" }
      },
      "required": ["name", "frame", "command_type", "hex", "decoded"],
      "additionalProperties": false
    },
    "stream_vector": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" },
        "decoded": { "type": "object" }
      },
      "required": ["name", "message", "hex", "decoded"],
      "additionalProperties": false
    },
    "vector_document": {
      "allOf": [
        { "$ref": "#/$defs/artifact_header" },
        {
          "type": "object",
          "properties": {
            "$schema": { "type": "string" },
            "schema_version": { "const": 1 },
            "scope": { "const": "gateway_client_telemetry_vectors" },
            "crypto_v3": { "$ref": "#/$defs/crypto_v3" },
            "telemetry": {
              "type": "array",
              "items": { "$ref": "#/$defs/telemetry_vector" }
            },
            "invalid_telemetry": {
              "type": "array",
              "items": { "$ref": "#/$defs/invalid_telemetry_vector" }
            },
            "commands": {
              "type": "array",
              "items": { "$ref": "#/$defs/command_vector" }
            },
            "gateway_stream": {
              "type": "array",
              "items": { "$ref": "#/$defs/stream_vector" }
            }
          },
          "required": [
            "$schema",
            "schema_version",
            "scope",
            "telemetry",
            "invalid_telemetry",
            "commands",
            "gateway_stream"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
