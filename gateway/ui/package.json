{
  "name": "@osk-sense/gateway-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "format:staged": "node scripts/format.mjs --staged",
    "test:format": "node --test scripts/format.node-test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vue-tsc --noEmit && vite build && node scripts/compress-assets.mjs && node scripts/check-build.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "vue": "3.5.21",
    "vue-i18n": "11.1.12",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@intlify/devtools-types": "^11.1.12",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "^2.5.0",
    "clang-format-node": "4.0.2",
    "jsdom": "^30.0.1",
    "lint-staged": "17.6.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "3.0.6"
  }
}
