#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: Node.js is required. Install Node.js and run npm ci in gateway/ui." >&2
  exit 1
fi

if [ ! -d gateway/ui/node_modules/lint-staged ]; then
  echo "pre-commit: run npm ci in gateway/ui to install the formatters." >&2
  exit 1
fi

node gateway/ui/scripts/format.mjs --staged

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
generate_pattern='^protocol/(protocol-manifest\.json|scripts/generate_protocol_docs\.mjs)$'
validate_pattern='^protocol/(protocol-manifest\.json|protocol-manifest\.schema\.json|protocol-vectors\.json|scripts/(generate_protocol_docs|validate_protocol_artifacts)\.mjs)$'

needs_generation=0
needs_validation=0
if printf '%s\n' "$staged_files" | grep -Eq "$generate_pattern"; then
  needs_generation=1
fi
if printf '%s\n' "$staged_files" | grep -Eq "$validate_pattern"; then
  needs_validation=1
fi

if [ "$needs_generation" -eq 0 ] && [ "$needs_validation" -eq 0 ]; then
  exit 0
fi

if [ "$needs_generation" -eq 1 ]; then
  if ! git diff --quiet -- \
    protocol/protocol-manifest.json \
    protocol/scripts/generate_protocol_docs.mjs; then
    echo "pre-commit: stage all manifest/generator changes before generating diagrams." >&2
    exit 1
  fi
  node protocol/scripts/generate_protocol_docs.mjs
fi

node protocol/scripts/validate_protocol_artifacts.mjs

if [ "$needs_generation" -eq 1 ]; then
  generated_changes=$(
    {
      git diff --name-only -- protocol/generated
      git ls-files --others --exclude-standard -- protocol/generated
    } | sed '/^$/d'
  )
  if [ -n "$generated_changes" ]; then
    echo "pre-commit: protocol diagrams were regenerated; stage them and commit again:" >&2
    printf '%s\n' "$generated_changes" | sed 's/^/  /' >&2
    exit 1
  fi
fi
